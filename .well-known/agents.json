{
  "$schema": "https://agents.md/schema/v1/agents.json",
  "name": "evo-skillopt",
  "description": "Text-space skill optimization for production LLM agents, callable over HTTP. Evolves a bot's Markdown skill file against a held-out eval set with git-tracked audit trails.",
  "homepage": "https://github.com/dnzengou/evo-skillopt",
  "docs": "https://dnzengou.github.io/evo-skillopt",
  "license": "MIT",
  "keywords": [
    "agent",
    "prompt-optimization",
    "skill-learning",
    "LLM",
    "agentic",
    "skillopt",
    "evaluation",
    "fitness",
    "RRSS",
    "cascade",
    "ARM"
  ],
  "capabilities": {
    "evolves": "markdown skill files",
    "trains_on": "held-out eval sets",
    "callable_from": "any language via HTTP",
    "deployment": ["pip", "docker-compose", "fly.io", "k8s", "railway", "render"]
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/",
      "auth": "none",
      "purpose": "service card — name, endpoints, discovery paths, docs link",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/health",
      "auth": "none",
      "purpose": "liveness probe",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/metrics",
      "auth": "none",
      "purpose": "Prometheus RED-method metrics (503 if prometheus_client not installed)",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/.well-known/agents.json",
      "auth": "none",
      "purpose": "this manifest",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/.well-known/openapi.yaml",
      "auth": "none",
      "purpose": "OpenAPI 3.1 contract for every endpoint",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/llms.txt",
      "auth": "none",
      "purpose": "llms.txt-convention LLM crawl aid",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/llms-full.txt",
      "auth": "none",
      "purpose": "full self-contained LLM summary",
      "idempotent": true
    },
    {
      "method": "POST",
      "path": "/train",
      "auth": "bearer",
      "purpose": "run one SkillOpt training pass against a bot's skill + eval set",
      "idempotent": false,
      "optional_overlays": ["rrss"]
    },
    {
      "method": "POST",
      "path": "/train/cascade",
      "auth": "bearer",
      "purpose": "aggregate and gate a pipeline of pre-scored skills",
      "idempotent": true
    },
    {
      "method": "POST",
      "path": "/fitness/arm",
      "auth": "bearer",
      "purpose": "reduce Acquire/Retain/Monetize signals to one composite fitness",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/bots/{id}/skill",
      "auth": "bearer",
      "purpose": "current skill file (or ?version=X.Y.Z for a specific one)",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/bots/{id}/history",
      "auth": "bearer",
      "purpose": "versioned history with per-version gate_score_delta and source",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/bots/{id}/diff",
      "auth": "bearer",
      "purpose": "unified diff between two versions — ?from=X.Y.Z&to=A.B.C",
      "idempotent": true
    },
    {
      "method": "POST",
      "path": "/bots/{id}/rollback",
      "auth": "bearer",
      "purpose": "point current at an existing older version; never destructive",
      "idempotent": false
    },
    {
      "method": "GET",
      "path": "/cost/models",
      "auth": "none",
      "purpose": "known-model price registry (USD per 1k tokens)",
      "idempotent": true
    },
    {
      "method": "POST",
      "path": "/cost/estimate",
      "auth": "bearer",
      "purpose": "pre-run token + dollar estimate for one evolution against a model + workload",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/jobs",
      "auth": "bearer",
      "purpose": "list async-queue jobs (filters: status, bot_id, limit, offset); includes a counts-by-status summary",
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "auth": "bearer",
      "purpose": "status + result of one async /train job",
      "idempotent": true
    }
  ],
  "concepts": {
    "skill": "A Markdown document specifying what a bot does, how, and what it must never do. The learnable parameter.",
    "evolution": "One full training cycle: rollout -> reflect -> aggregate -> select -> update -> gate.",
    "gate": "A hard validation check. A proposed skill diff must beat the eval score by at least gate_min_improvement.",
    "rrss": "Four-axis resilience gate: Robustify, Reliabilify, Solidify, Stabilize.",
    "cascade": "An ordered list of skills treated as one behavior contract; each stage must clear a per-stage floor plus an aggregate threshold.",
    "arm": "Three-bucket signal classifier: Acquire, Retain, Monetize. Reduces heterogeneous production signals to one lifecycle-weighted fitness."
  },
  "entry_points": {
    "overview":        "./README.md",
    "orientation":     "./AGENTS.md",
    "llms_txt":        "./llms.txt",
    "llms_full":       "./llms-full.txt",
    "openapi":         "./.well-known/openapi.yaml",
    "citation":        "./CITATION.cff",
    "blueprint":       "./EvoSkillOpt_Blueprint.md",
    "glossary":        "./docs/GLOSSARY.md",
    "gtm_playbook":    "./GTM.md",
    "ai_seo_notes":    "./docs/AI_SEO.md",
    "showcase":        "./SHOWCASE.md",
    "release_guide":   "./RELEASING.md",
    "worker_readme":   "./worker/README.md",
    "worker_source":   "./worker/skillopt_worker.py"
  },
  "contact": {
    "security": "./SECURITY.md",
    "issues":   "https://github.com/dnzengou/evo-skillopt/issues"
  }
}
