# evo-skillopt environment variables
# Copy this file to .env and fill in your values.
#     cp .env.example .env
# Never commit .env to git.

# ─── Worker ──────────────────────────────────────────────────────────
# Bearer token clients must present on POST /train. Leave unset only
# in local dev. Generate with:  openssl rand -hex 32
WORKER_TOKEN=

# Local port the worker listens on
WORKER_PORT=9000

# Where training runs write their outputs (inside the container)
OUTPUT_ROOT=/data/outputs

# Path to SkillOpt's train entrypoint (leave as default in container)
TRAIN_SCRIPT=/app/scripts/train.py

# ─── LLM providers — set whichever backend your skills use ───────────

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1        # override for proxies / local

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini via Google AI Studio)
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Alternative auth (no key):
# AZURE_OPENAI_AUTH_MODE=azure_cli
# AZURE_OPENAI_AUTH_MODE=managed_identity
# AZURE_OPENAI_MANAGED_IDENTITY_CLIENT_ID=

# Local model via Ollama (OpenAI-compatible)
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://host.docker.internal:11434/v1

# Local model via vLLM (OpenAI-compatible)
# QWEN_CHAT_BASE_URL=http://localhost:8000/v1
# QWEN_CHAT_MODEL=Qwen/Qwen3.5-4B
